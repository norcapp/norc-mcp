{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.norcapp/norc-mcp",
  "title": "norc",
  "description": "Manage cron jobs, machines and run history in your norc account from any AI chat.",
  "websiteUrl": "https://norc.app/mcp",
  "icons": [
    {
      "src": "https://norc.app/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/norcapp/norc-mcp",
    "source": "github"
  },
  "version": "0.3.2",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.norc.app/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token with your norc API key (vault.norc.app, Settings, API Keys)",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "Your norc API key (norc_sk_...)",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
