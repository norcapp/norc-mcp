{
  "name": "norc-mcp",
  "version": "0.2.2",
  "description": "MCP server for connecting AI platforms to your norc account — manage cron jobs, machines, and run history.",
  "type": "module",
  "license": "MIT",
  "main": "dist/server.js",
  "bin": {
    "norc-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norcapp/norc-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
